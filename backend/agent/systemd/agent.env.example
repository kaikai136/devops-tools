DEVOPS_AGENT_SOCKET=/run/devops-agent/agent.sock
DEVOPS_AGENT_TOKEN_FILE=/etc/devops-agent/agent.token
DEVOPS_AGENT_STATE_DIR=/var/lib/devops-agent
DEVOPS_WEB_ROOT=/home/web
DEVOPS_DOCKER_SOCKET=/var/run/docker.sock
DEVOPS_DOCKER_PID_FILE=/run/docker.pid
# Keep false so merely starting or polling the Agent cannot socket-activate dockerd.
DEVOPS_DOCKER_ALLOW_SOCKET_ACTIVATION=false
# Typed system actions only; no arbitrary shell or command endpoint is exposed.
DEVOPS_SYSTEM_WRITES_ENABLED=true
# Fixed IPinfo endpoints only; disable to omit public IP, ISP, and location metadata.
DEVOPS_PUBLIC_NETWORK_LOOKUP_ENABLED=true
