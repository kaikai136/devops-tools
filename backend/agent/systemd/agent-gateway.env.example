DEVOPS_AGENT_GATEWAY_LISTEN=0.0.0.0:9081
DEVOPS_AGENT_SOCKET=/run/devops-agent/agent.sock
DEVOPS_AGENT_TOKEN_FILE=/etc/devops-agent/agent.token
# The gateway token must be separate from the internal Agent token and contain
# at least 32 bytes. Generate one with: openssl rand -hex 32
DEVOPS_AGENT_GATEWAY_TOKEN_FILE=/etc/devops-agent/agent-gateway.token
# The installer allows local access, 172.16.0.0/24, and the installation host's
# current IPv4 /24 by default.
# Add explicit trusted integration CIDRs only when the gateway is protected by
# host firewall rules or an HTTPS reverse proxy.
DEVOPS_AGENT_GATEWAY_ALLOWED_CIDRS=127.0.0.0/8,::1/128,172.16.0.0/24
DEVOPS_AGENT_GATEWAY_MAX_REQUEST_BYTES=64MiB
DEVOPS_AGENT_GATEWAY_MAX_RESPONSE_BYTES=512MiB
